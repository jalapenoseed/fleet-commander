; Fleet Commander — Godot 4 port
; Open this file in Godot 4.3 or newer, then press F6/F5.
config_version=5

[application]

config/name="Fleet Commander"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.008, 0.014, 0.025, 1)

[physics]

common/physics_ticks_per_second=60

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
camera_next={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
toggle_pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
toggle_cinematic={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194339)]
}
toggle_interface={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72)]
}
select_next={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194308)]
}
zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}

[layer_names]

3d_physics/layer_1="Arena"
3d_physics/layer_2="Aircraft"
3d_physics/layer_3="Payloads"
